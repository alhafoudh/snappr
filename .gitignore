# The list of dylibs Tauri copies into Contents/Frameworks, written by
# `cargo xtask closure` from what it actually put in build/vips. Derived from
# gitignored output, so it is gitignored too - `mise run app` regenerates it
# before every bundle.
/src-tauri/tauri.frameworks.json

# macOS
.DS_Store

# The bundled Ruby runtime and the libvips closure, built by bin/build-runtime.
# Large, machine-specific and fully reproducible from the script, so it is never
# committed. See "Build and bundling" in CLAUDE.md.
/build/

# snappr's own output and in-progress files. These normally land next to the
# source photo in ~/Downloads, but `bin/snappr overlay` can be pointed at a file
# inside the project while iterating on the overlays.
*.overlay.png
*.tmp-*

# Tauri / frontend build output.
/node_modules/
/dist/
# Cargo builds into the workspace root now that src-tauri is a member, so the
# old /src-tauri/target/ path no longer catches anything.
/target/
/src-tauri/target/
/src-tauri/gen/
/src-tauri/binaries/
