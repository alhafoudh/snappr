#!/usr/bin/env ruby
# frozen_string_literal: true

# Runs the real snappr pipeline inside the bundled runtime and proves the bundle
# is self-contained.
#
#   bin/verify-bundle
#
# This is the gate that matters, and it exists because of a specific trap. FFI
# hardcodes /opt/homebrew/lib into its library search path on macOS arm64
# (ffi/dynamic_library.rb, "we hardcode the path for arm64 here"), second only to
# LD_LIBRARY_PATH. So a bundle that is missing a dylib does not fail here - it
# silently borrows Homebrew's copy, passes every test on this machine, and then
# fails on the operator's Mac where Homebrew does not exist.
#
# The structural checks in bin/build-vips cannot catch that either, because the
# thing that went missing the first time round was not reachable from otool at
# all: libvips dlopens its format support from vips-modules-8.18/ at runtime, so
# the closure had no HEIC support and no libheif, and a dependency walk had no way
# to know.
#
# Hence the two-part test below: run the actual pipeline on an actual HEIC, and
# separately assert via DYLD_PRINT_LIBRARIES that not one library came from
# /opt/homebrew. Passing the first without the second means nothing.
#
# LD_LIBRARY_PATH, not DYLD_LIBRARY_PATH, is what points FFI at the bundled
# libvips. That is deliberate and it is worth knowing why: FFI reads both from
# Ruby's ENV and does the path joining itself in Ruby, so LD_LIBRARY_PATH works
# even though it means nothing to dyld on macOS - and unlike DYLD_*, it is not
# stripped from the environment under hardened runtime. That removes the need for
# the com.apple.security.cs.allow-dyld-environment-variables entitlement.

require "json"
require "open3"
require "pathname"
require "rbconfig"
require "tmpdir"

class VerifyBundle
  def initialize(root)
    @root = root
    @runtime = root.join("build/ruby-runtime/bin/ruby")
    @vips = root.join("build/vips")
    @gems = root.join("build/gems/bundler/setup.rb")
    @failures = 0
  end

  def call
    missing = { "ruby runtime" => @runtime, "vips closure" => @vips, "gem bundle" => @gems }
                .reject { |_label, path| path.exist? }
    unless missing.empty?
      abort "missing #{missing.keys.join(", ")} - run bin/build-runtime and bin/build-vips first"
    end

    log "running the pipeline inside the bundled runtime"
    stdout, stderr, status = Dir.mktmpdir("snappr-fixture") { |dir| run_probe(build_fixture(dir)) }

    unless status.success?
      puts stderr.lines.reject { |l| l.start_with?("dyld[") }.last(25).join
      abort "the probe failed - see above"
    end

    result = JSON.parse(stdout.lines.last.to_s)
    puts
    log "=== verification ==="

    check("HEIC header read", result["source_width"] == 2400 && result["source_height"] == 1600,
          "#{result["source_width"]}x#{result["source_height"]}")
    # The check that sharp's libvips failed. Header reads are lazy; this forces a
    # real HEVC decode, and the mean of a known flat patch proves the pixels are
    # the ones that went in.
    check("HEVC pixels actually decode", result["heic_pixels"].to_f.between?(100.0, 115.0),
          result["heic_pixels"].to_s)
    check("landscape orientation detected", result["orientation"] == "landscape", result["orientation"])
    check("landscape overlay chosen", result["svg"].to_s.include?("landscape"), result["svg"])
    check("overlay PNG written", result["bytes"].to_i.positive?, result["bytes"].to_s)
    # The canvas is derived so the window lands at exactly the crop the photo can
    # supply, which makes the output the paper's shape. Note it is NOT necessarily
    # wider than the source: the crop discards width first, then the canvas is
    # grown back out from what survived.
    ratio = result["output_width"].to_f / result["output_height"].to_f
    check("output has the 148:100 print ratio", (ratio - 1.48).abs < 0.01,
          "#{result["output_width"]}x#{result["output_height"]} = #{ratio.round(4)}")
    check("bit depth preserved as 8", result["depth"] == 8, result["depth"].to_s)
    check("no pipeline warnings", Array(result["warnings"]).empty?,
          Array(result["warnings"]).map { |w| w["kind"] }.join(", "))
    check("three previews written", result["previews"].to_a.size == 3, result["previews"].to_a.size.to_s)
    check("previews are sRGB-tagged", result["preview_has_icc"] == true, result["preview_has_icc"].to_s)
    check("thumb is 400px on its long edge", result["thumb_long_edge"] == 400,
          result["thumb_long_edge"].to_s)

    # The one that catches a bundle that only works on this machine.
    borrowed = stderr.lines.grep(%r{dyld\[.*\]: .*/opt/homebrew}).map { |l| l[%r{/opt/homebrew\S+}] }.uniq
    check("nothing loaded from Homebrew", borrowed.empty?,
          "#{borrowed.size} libs, e.g. #{borrowed.first(2).join(", ")}")

    loaded = stderr.lines.grep(/dyld\[/).size
    puts
    log "#{loaded} libraries loaded, #{borrowed.size} of them from Homebrew"

    if @failures.zero?
      log "the bundled runtime is self-contained. Ready for step 3."
      0
    else
      log "#{@failures} check(s) failed"
      1
    end
  end

  private

  def run_probe(fixture)
    Open3.capture3(
      {
        # Nothing else: prove the bundle needs no ambient environment.
        "LD_LIBRARY_PATH" => @vips.to_s,
        # libheif has its own plugin system, with its directory baked in at compile
        # time exactly like libvips' modules - Homebrew's points at
        # /opt/homebrew/lib/libheif. Left alone, libheif opportunistically dlopens
        # every plugin it finds there, and since each of those links Homebrew's
        # libheif by absolute path, a second copy of libheif arrives along with
        # ffmpeg, opus, vpx, dav1d, x264 and the rest.
        #
        # None of them are wanted: libde265, the HEVC decoder, is linked directly
        # into libheif, and decoding is all snappr ever does. So point the plugin
        # path at somewhere empty and let the scan find nothing.
        "LIBHEIF_PLUGIN_PATH" => @vips.join("no-heif-plugins").to_s,
        "SNAPPR_ROOT" => @root.to_s,
        "SNAPPR_LOG_LEVEL" => "warn",
        "SNAPPR_VERIFY_HEIC" => fixture,
        "DYLD_PRINT_LIBRARIES" => "1",
        "PATH" => "/usr/bin:/bin",
        "HOME" => Dir.home,
        "TMPDIR" => ENV.fetch("TMPDIR", "/tmp")
      },
      @runtime.to_s, "--disable-gems", "-r", @gems.to_s, "-I", @root.join("lib").to_s,
      probe_path.to_s,
      unsetenv_others: true
    )
  end

  # Built OUTSIDE the bundle, with the system libvips, because snappr only ever
  # decodes HEIC - it has no reason to encode one, and asking the bundle to do so
  # would test a capability the product does not need while dragging in the whole
  # HEVC encoder tail.
  def build_fixture(dir)
    path = File.join(dir, "IMG_VERIFY.heic")
    script = <<~RUBY
      require "vips"
      Vips::Image.black(2400, 1600).add([90, 110, 130]).cast(:uchar)
                 .copy(interpretation: :srgb).write_to_file(#{path.inspect})
    RUBY
    _out, err, status = Open3.capture3(RbConfig.ruby, "-e", script)
    abort "could not build the HEIC fixture with the system libvips:\n#{err}" unless status.success?

    path
  end

  def probe_path = @root.join("bin/verify-bundle-probe.rb")

  def check(label, ok, detail = nil)
    @failures += 1 unless ok
    suffix = detail && !detail.empty? && !ok ? "  (#{detail})" : ""
    puts "  #{ok ? "ok  " : "FAIL"} #{label}#{suffix}"
  end

  def log(message) = puts("verify-bundle: #{message}")
end

exit(VerifyBundle.new(Pathname.new(__dir__).parent.expand_path).call || 0)
