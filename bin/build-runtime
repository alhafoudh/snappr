#!/usr/bin/env ruby
# frozen_string_literal: true

# Builds the relocatable Ruby runtime that ships inside snappr.app.
#
# The Ruby that mise installs cannot be used: its prefix is compiled in, so a
# copied binary looks for its stdlib back in ~/.local/share/mise, and it links out
# to Homebrew's libgmp. This produces a Ruby whose stdlib is found relative to the
# binary and whose only remaining dylib references can be rewritten to point
# inside the bundle.
#
#   bin/build-runtime            build, skipping any step already done
#   bin/build-runtime --force    wipe build/ruby-runtime and start over
#   bin/build-runtime --verify   run only the verification gate
#
# Everything lands under build/, which is gitignored: this script is the source of
# truth, not its output.
#
# Why each configure flag is there - none of these are cosmetic:
#
#   --enable-load-relative   the whole point. Makes the binary find its stdlib at
#                            <bin>/../lib/ruby/<ver> instead of at the compiled-in
#                            prefix, so the tree can be moved into the .app.
#   --disable-shared         links libruby into the ruby binary. One less dylib to
#                            relocate, and one less Mach-O file to codesign.
#   --with-static-linked-ext links every stdlib C extension into the binary too, so
#                            there are no stdlib .bundle files at all. This matters
#                            more than it looks: Tauri does not sign anything under
#                            Contents/Resources, so every .bundle that survives here
#                            would have to be placed in Contents/Frameworks by hand
#                            and would fail notarization if it were missed.
#   --with-libyaml-dir       pointed at a staging directory holding only libyaml.a,
#                            so psych links libyaml statically. psych is not
#                            optional: it is what reads config/snappr.yml.
#   --without-gmp            drops a Homebrew dylib. It only accelerates Bignum,
#                            which this pipeline never does.
#   --with-out-ext=...       drops the extensions that drag in dylibs of their own
#                            (libssl, libcrypto, libreadline, libncurses, libgdbm)
#                            and are unreachable from snappr anyway.
#
# openssl is excluded, which needs justifying twice over. snappr does no network
# I/O, and the bundled app never installs gems, so nothing in the runtime path
# wants it: SecureRandom uses Random.urandom, and digest is its own extension.
#
# The reason it is worth excluding rather than just leaving in is that with
# --with-static-linked-ext every extension is linked into the ruby binary at build
# time, and Homebrew's openssl is keg-only - so keeping it means both plumbing
# --with-openssl-dir through and shipping libssl and libcrypto in
# Contents/Frameworks. Excluding it means the ruby binary links nothing outside
# /usr/lib and /System at all, which is a far easier invariant to keep true.
#
# The cost is that `bundle install` cannot run under this Ruby (no HTTPS), so the
# gem tree is built with mise's Ruby 3.4.5 instead. That is safe, and it was
# checked rather than assumed: the only gem in the bundle with a compiled artefact
# is ffi, and its precompiled arm64-darwin binary links nothing but libSystem,
# leaving its 128 _rb_* symbols to resolve against the host process at load time.
# So it does not need libruby.dylib and works unchanged against a static-libruby
# interpreter of the same 3.4 ABI.

require "digest"
require "etc"
require "fileutils"
require "open3"
require "pathname"
require "tmpdir"

class BuildRuntime
  TARGET_RUBY = "3.4.5"

  # From rbenv/ruby-build's own definition for 3.4.5, which is the checksum
  # ruby-lang.org publishes for the tarball.
  TARBALL_SHA256 = "1d88d8a27b442fdde4aa06dc99e86b0bbf0b288963d8433112dd5fac798fd5ee"

  EXCLUDED_EXTENSIONS = %w[openssl readline curses dbm gdbm win32 win32ole].freeze

  # Homebrew ships a static archive alongside the dylib, so there is nothing to
  # build from source - just present it on its own so configure cannot find a
  # .dylib to prefer.
  HOMEBREW_LIBYAML = "/opt/homebrew/opt/libyaml"

  def initialize(root)
    @root = root
    @build = root.join("build")
    @cache = @build.join("cache")
    @src = @build.join("src/ruby-#{TARGET_RUBY}")
    @deps = @build.join("deps")
    @prefix = @build.join("ruby-runtime")
  end

  def call(argv)
    return verify if argv.include?("--verify")

    FileUtils.rm_rf(@prefix) if argv.include?("--force")

    if @prefix.join("bin/ruby").exist?
      log "ruby-runtime already built, re-pruning and verifying (--force to rebuild)"
      prune
      return verify
    end

    fetch
    extract
    stage_libyaml
    configure
    build_and_install
    prune
    verify
  end

  private

  # Ruby installs its bundled gems - debug, rbs, racc, bigdecimal, nkf, syslog -
  # into lib/ruby/gems, and those are gems, so --with-static-linked-ext does not
  # touch them: they arrive as .bundle files with .dSYM debug symbols beside them.
  #
  # Every one of them is dead weight here. snappr's own dependencies are vendored
  # separately by `bundle install --standalone`, and rexml - the one bundled gem
  # the pipeline does use - is declared in the Gemfile for exactly that reason. So
  # nothing in this tree is reachable, and each surviving .bundle would otherwise
  # have to be hand-placed in Contents/Frameworks and would fail notarization if it
  # were missed.
  #
  # specifications/default is kept: it is a few KB of text and it keeps `gem list`
  # honest if anyone runs it while debugging the bundle.
  PRUNE = ["lib/ruby/gems/*/gems", "lib/ruby/gems/*/extensions",
           "lib/ruby/gems/*/cache", "lib/ruby/gems/*/doc",
           "lib/ruby/gems/*/plugins", "**/*.dSYM"].freeze

  def prune
    before = disk_usage
    removed = PRUNE.sum do |pattern|
      @prefix.glob(pattern).sum do |path|
        size = path.directory? ? 0 : 1
        FileUtils.rm_rf(path)
        size + 1
      end
    end
    log "pruned #{removed} unreachable paths, #{before} -> #{disk_usage}"
  end

  def disk_usage
    out, _err, _status = Open3.capture3("du", "-sh", @prefix.to_s)
    out.split.first.to_s
  end

  def fetch
    tarball = @cache.join("ruby-#{TARGET_RUBY}.tar.gz")
    if tarball.exist? && Digest::SHA256.file(tarball).hexdigest == TARBALL_SHA256
      log "tarball already fetched and verified"
      return tarball
    end

    FileUtils.mkdir_p(@cache)
    url = "https://cache.ruby-lang.org/pub/ruby/#{TARGET_RUBY[/\A\d+\.\d+/]}/ruby-#{TARGET_RUBY}.tar.gz"
    log "fetching #{url}"
    run("curl", "-fL", "--retry", "3", "-o", tarball.to_s, url)

    actual = Digest::SHA256.file(tarball).hexdigest
    unless actual == TARBALL_SHA256
      FileUtils.rm_f(tarball)
      abort "checksum mismatch for ruby-#{TARGET_RUBY}.tar.gz\n  expected #{TARBALL_SHA256}\n  got      #{actual}"
    end
    log "checksum verified"
    tarball
  end

  def extract
    if @src.join("configure").exist?
      log "source already extracted"
      return
    end

    FileUtils.mkdir_p(@src.dirname)
    log "extracting into #{rel(@src)}"
    run("tar", "xzf", @cache.join("ruby-#{TARGET_RUBY}.tar.gz").to_s, "-C", @src.dirname.to_s)
  end

  # configure prefers a .dylib over a .a when both sit in the same libdir, so the
  # only reliable way to force a static libyaml is to show it a directory that
  # contains nothing else.
  def stage_libyaml
    stage = @deps.join("libyaml")
    if stage.join("lib/libyaml.a").exist?
      log "static libyaml already staged"
      return stage
    end

    archive = File.join(HOMEBREW_LIBYAML, "lib/libyaml.a")
    header = File.join(HOMEBREW_LIBYAML, "include/yaml.h")
    unless File.exist?(archive) && File.exist?(header)
      abort "need a static libyaml at #{HOMEBREW_LIBYAML} (brew install libyaml)"
    end

    FileUtils.mkdir_p([stage.join("lib"), stage.join("include")])
    FileUtils.cp(archive, stage.join("lib/libyaml.a"))
    FileUtils.cp(header, stage.join("include/yaml.h"))
    log "staged static libyaml in #{rel(stage)}"
    stage
  end

  def configure
    args = [
      "--prefix=#{@prefix}",
      "--enable-load-relative",
      "--disable-shared",
      "--with-static-linked-ext",
      # --with-libyaml-dir alone is not enough. It tells psych's extconf where to
      # look, but with --with-static-linked-ext the actual -lyaml resolution happens
      # in the final link of exe/ruby, which does not inherit that path and fails
      # with "ld: library 'yaml' not found". --with-opt-dir adds the include and lib
      # directories globally, which is what reaches the final link.
      "--with-opt-dir=#{@deps.join("libyaml")}",
      "--with-libyaml-dir=#{@deps.join("libyaml")}",
      "--without-gmp",
      "--with-out-ext=#{EXCLUDED_EXTENSIONS.join(",")}",
      "--disable-install-doc",
      "CC=clang"
    ]

    # Compare against the flags the existing Makefile was generated from, rather
    # than just testing that a Makefile exists. Editing a flag in this script and
    # having the build silently reuse the old configuration is a long, confusing
    # debugging session.
    marker = @src.join(".snappr-configure-args")
    if marker.exist? && marker.read == args.join("\n") && @src.join("Makefile").exist?
      log "already configured with these flags"
      return
    end

    if @src.join("Makefile").exist?
      log "configure flags changed, cleaning first"
      system("make", "distclean", chdir: @src.to_s, out: File::NULL, err: File::NULL)
    end

    log "configuring:\n  #{args.join("\n  ")}"
    run("./configure", *args, chdir: @src)
    marker.write(args.join("\n"))
  end

  def build_and_install
    jobs = Etc.nprocessors
    log "building with -j#{jobs} (this takes a few minutes)"
    run("make", "-j#{jobs}", chdir: @src)
    log "installing into #{rel(@prefix)}"
    run("make", "install", chdir: @src)
  end

  # The gate. A runtime that builds but is not relocatable is worse than useless,
  # because it works on this machine and fails on the operator's.
  def verify
    ruby = @prefix.join("bin/ruby")
    abort "no runtime at #{rel(ruby)} - run without --verify first" unless ruby.exist?

    puts
    log "=== verification ==="

    version = capture(ruby.to_s, "-e", "print RUBY_VERSION")
    check("reports #{TARGET_RUBY}", version == TARGET_RUBY, version)

    relative = capture(ruby.to_s, "-rrbconfig", "-e", 'print RbConfig::CONFIG["LIBRUBY_RELATIVE"]')
    check("LIBRUBY_RELATIVE=yes", relative == "yes", relative)

    libruby = @prefix.glob("lib/libruby*.dylib")
    check("no libruby dylib (static)", libruby.empty?, libruby.map { |p| p.basename.to_s }.join(", "))

    bundles = @prefix.glob("lib/ruby/**/*.bundle")
    check("no stdlib .bundle files", bundles.empty?, "#{bundles.size} found")

    deps = dylib_deps(ruby)
    homebrew = deps.grep(%r{\A/opt/homebrew})
    check("no Homebrew dylibs", homebrew.empty?, homebrew.join(", "))

    log "ruby links: #{deps.empty? ? "(nothing outside the binary)" : deps.join(", ")}"

    # The real test: move the whole tree somewhere else, cd somewhere unrelated,
    # and see whether it still finds its stdlib. This is what happens when the
    # tree is copied into snappr.app.
    Dir.mktmpdir("snappr-relocate") do |tmp|
      moved = File.join(tmp, "runtime")
      FileUtils.cp_r(@prefix.to_s, moved)
      moved_ruby = File.join(moved, "bin/ruby")

      out = capture(moved_ruby, "-e", 'require "yaml"; print YAML.safe_load("a: 1").fetch("a")', chdir: "/")
      check("runs from a moved tree, psych works", out == "1", out)

      out = capture(moved_ruby, "-e", 'require "json"; print JSON.parse(%({"a":1})).fetch("a")', chdir: "/")
      check("json works", out == "1", out)

      # Tempfile is on the pipeline's hot path (overlay.rb writes the ICC profile
      # through it), and it pulls in SecureRandom - which is the one place a
      # missing openssl could plausibly have bitten.
      out = capture(moved_ruby, "-e", 'require "tempfile"; Tempfile.create("x") { |f| print File.exist?(f.path) }', chdir: "/")
      check("tempfile and securerandom work without openssl", out == "true", out)

      # realpath on both sides: macOS symlinks /var to /private/var, so a literal
      # comparison fails on a correct result.
      out = capture(moved_ruby, "-rrbconfig", "-e", 'print RbConfig::CONFIG["prefix"]', chdir: "/")
      check("prefix follows the binary", File.realpath(out) == File.realpath(moved), "#{out} != #{moved}")
    end

    puts
    if @failures.to_i.zero?
      log "runtime is relocatable. Next: the libvips closure (step 2)."
      0
    else
      log "#{@failures} check(s) failed"
      1
    end
  end

  def dylib_deps(path)
    capture("otool", "-L", path.to_s)
      .lines.drop(1)
      .map { |line| line.strip.split(" (").first }
      .compact
      .reject { |lib| lib.start_with?("/usr/lib", "/System") }
  end

  def check(label, ok, detail = nil)
    @failures = @failures.to_i + (ok ? 0 : 1)
    mark = ok ? "ok  " : "FAIL"
    suffix = detail && !detail.empty? && !ok ? "  (#{detail})" : ""
    puts "  #{mark} #{label}#{suffix}"
  end

  def run(*cmd, chdir: @root)
    ok = system(*cmd, chdir: chdir.to_s)
    abort "command failed: #{cmd.join(" ")}" unless ok
  end

  def capture(*cmd, chdir: @root)
    out, _err, _status = Open3.capture3(*cmd, chdir: chdir.to_s)
    out.strip
  end

  def rel(path) = Pathname.new(path).relative_path_from(@root).to_s
  def log(message) = puts("build-runtime: #{message}")
end

exit(BuildRuntime.new(Pathname.new(__dir__).parent.expand_path).call(ARGV) || 0)
