#!/usr/bin/env ruby
# frozen_string_literal: true

# Collects libvips and everything it drags in, and rewrites the lot to be
# relocatable, ready to drop into snappr.app/Contents/Frameworks.
#
#   bin/build-vips            collect and relocate, then verify
#   bin/build-vips --force    wipe build/vips and start over
#   bin/build-vips --verify   run only the verification gate
#
# Homebrew's dylibs reference each other by absolute path, so a copy of libvips
# taken as-is still loads Homebrew's copy of glib - and on a machine with no
# Homebrew it loads nothing at all. Every reference has to be rewritten to
# @loader_path, which is what makes a flat directory of dylibs work wherever it
# is put.
#
# The libvips it starts from is the one bin/build-libvips produces, NOT Homebrew's.
# That matters: Homebrew's libvips dlopens its format support from
# <libdir>/vips-modules-8.18/ using a path baked in at compile time, so a copy of it
# has no HEIC support wherever you put it. See the header of bin/build-libvips for
# the full story. Our build has heif, rsvg, png and jpeg linked in, which is what
# makes a plain dependency walk sufficient here.
#
# Four things are not obvious and are load-bearing:
#
# 1. Files are keyed by the basename of the INSTALL NAME, not of the real file.
#    Homebrew's libpng16.16.dylib is a symlink to a versioned file, but every
#    dependent records the symlink's name. Copy the real bytes, under the name the
#    dependents actually ask for, or nothing resolves.
#
# 2. **@rpath dependencies have to be followed too.** Some Homebrew formulae refer
#    to their siblings as @rpath/libfoo.dylib rather than by absolute path, and
#    resolving that needs the dependent's own LC_RPATH entries - which are
#    themselves often @loader_path-relative. A walk that follows only absolute
#    paths drops those silently, and the resulting libvips fails to dlopen.
#
# 3. The directory must end up containing only flat, real Mach-O files. Tauri's
#    bundler runs codesign over everything in Contents/Frameworks and aborts the
#    whole build on the first thing it cannot sign, so a stray symlink or
#    subdirectory in here is a build failure much later and far from its cause.
#
# 4. install_name_tool invalidates the existing signature, so each file is
#    re-signed ad-hoc afterwards. Tauri re-signs with the Developer ID at bundle
#    time, but dyld refuses to load a file whose signature is present and wrong,
#    which makes this fail during development rather than at distribution.

require "fileutils"
require "open3"
require "pathname"
require "set"

class BuildVips
  # Our own build, not Homebrew's. See the header.
  ROOT_LIBRARY = "build/libvips-prefix/lib/libvips.42.dylib"

  # Only these prefixes are followed and rewritten. /usr/lib and /System are the
  # OS's own, present on every Mac, and must be left exactly as they are.
  VENDOR_PREFIXES = ["/opt/homebrew", "/usr/local"].freeze

  # The loaders snappr actually uses. Reported at the end so it is obvious when a
  # libvips build is missing something the pipeline needs.
  REQUIRED_LOADERS = %w[svgload heifload pngload jpegload pngsave].freeze

  def initialize(root)
    @root = root
    @source = root.join(ROOT_LIBRARY)
    @dest = root.join("build/vips")
  end

  def call(argv)
    return verify if argv.include?("--verify")

    FileUtils.rm_rf(@dest) if argv.include?("--force")

    if @dest.exist? && !@dest.glob("*.dylib").empty?
      log "build/vips already populated, skipping to verification (--force to rebuild)"
      return verify
    end

    unless @source.exist?
      abort "no libvips at #{rel(@source)} - run bin/build-libvips first"
    end

    copy(collect([@source.to_s]))
    relocate
    verify
  end

  private

  # Breadth-first over otool -L, following only vendored paths. Returns a hash of
  # install-name basename => real source file.
  def collect(roots)
    log "walking the dependency closure from #{roots.size} root(s)"
    found = {}
    queue = roots.dup
    seen = Set.new

    until queue.empty?
      install_name = queue.shift
      next unless seen.add?(install_name)

      real = resolve(install_name)
      unless real
        log "  WARNING: #{install_name} is referenced but missing, skipping"
        next
      end

      name = File.basename(install_name)
      if found.key?(name) && found[name] != real
        log "  WARNING: two different files both called #{name} (#{found[name]}, #{real})"
      end
      found[name] = real

      rpaths = rpaths_of(real)
      dependencies_of(real).each do |dep|
        resolved = resolve_dependency(dep, real, rpaths)
        queue << resolved if resolved
      end
    end

    log "found #{found.size} dylibs, #{human(found.values.uniq.sum { |f| File.size(f) })}"
    found
  end

  def copy(closure)
    FileUtils.mkdir_p(@dest)
    closure.each do |name, source|
      target = @dest.join(name)
      # cp, not cp_r or ln: this must be a real file, never a symlink.
      FileUtils.copy_file(source, target)
      FileUtils.chmod(0o644, target)
    end
    log "copied #{closure.size} files into #{rel(@dest)}"
  end

  # Rewrite every id and every vendored dependency to @loader_path, so the whole
  # directory resolves internally wherever it is placed.
  def relocate
    files = @dest.glob("*.dylib").sort
    log "rewriting install names for #{files.size} dylibs"
    rewrite(files, deps: "@loader_path")
    log "rewrote and re-signed #{files.size} files"
  end

  def rewrite(files, deps:)
    files.each do |file|
      run("install_name_tool", "-id", "@loader_path/#{file.basename}", file.to_s)

      dependencies_of(file).each do |dep|
        next unless rewritable?(dep)

        run("install_name_tool", "-change", dep, "#{deps}/#{File.basename(dep)}", file.to_s)
      end

      # Homebrew bakes absolute LC_RPATH entries into some libraries. They are
      # harmless once nothing resolves through them, but they also point outside
      # the bundle, so strip them rather than shipping a stale search path.
      rpaths_of(file).each do |rpath|
        run("install_name_tool", "-delete_rpath", rpath, file.to_s) if vendored?(rpath)
      end

      # install_name_tool invalidated whatever signature was there.
      run("codesign", "--force", "--sign", "-", "--timestamp=none", file.to_s)
    end
  end

  def verify
    abort "nothing at #{rel(@dest)} - run without --verify first" unless @dest.exist?

    puts
    log "=== verification ==="
    @failures = 0

    top = @dest.glob("*").sort
    dylibs = top.select { |f| f.extname == ".dylib" }

    check("libvips itself is present", @dest.join("libvips.42.dylib").exist?)

    # HEIC decode is linked into libvips now rather than dlopened, so libheif must
    # show up as an ordinary dependency. If it does not, the libvips build lost its
    # heif support and most of what gets AirDropped becomes unreadable.
    check("libheif is a direct dependency", dylibs.any? { |f| f.basename.to_s.start_with?("libheif") },
          dylibs.map(&:basename).grep(/heif/).join(", "))

    # A module directory here means bin/build-libvips was built without
    # -Dmodules=disabled, which puts the un-relocatable module path back.
    modules = @dest.glob("vips-modules-*")
    check("no module directory", modules.empty?, modules.map(&:basename).join(", "))

    unexpected = top.reject { |f| f.extname == ".dylib" }
    check("nothing but dylibs at the top level", unexpected.empty?,
          unexpected.map(&:basename).join(", "))

    symlinks = top.select(&:symlink?)
    check("no symlinks", symlinks.empty?, symlinks.map(&:basename).join(", "))

    # The one that matters: nothing may still point at Homebrew, and nothing may
    # still go through @rpath - the rpaths that resolved it have been stripped, so
    # a surviving @rpath reference is a dlopen failure waiting to happen.
    leaked = dylibs.flat_map do |file|
      dependencies_of(file).select { |dep| rewritable?(dep) }.map { |dep| "#{file.basename} -> #{dep}" }
    end
    check("no vendored or @rpath references left", leaked.empty?, leaked.first(5).join("; "))

    # Only MH_DYLIB files carry an LC_ID_DYLIB. libvips' modules are MH_BUNDLE,
    # which by design has no install id - nothing ever links against them by name,
    # they are only ever dlopened - so install_name_tool -id is a silent no-op on
    # them and there is nothing here to assert.
    linkable = dylibs.reject { |f| bundle?(f) }
    ids = linkable.reject { |f| install_id_of(f) == "@loader_path/#{f.basename}" }
    check("every id is @loader_path-relative", ids.empty?, ids.map(&:basename).join(", "))

    # Every internal reference must actually exist, or it will fail at dlopen time
    # on a machine without Homebrew rather than here. Resolved relative to each
    # file's own directory, which is what @loader_path means.
    missing = dylibs.flat_map do |file|
      dependencies_of(file)
        .select { |dep| dep.start_with?("@loader_path/") }
        .reject { |dep| file.dirname.join(dep.delete_prefix("@loader_path/")).exist? }
        .map { |dep| "#{file.basename} -> #{dep}" }
    end
    check("every @loader_path reference resolves", missing.empty?, missing.first(5).join("; "))

    signed = dylibs.reject { |f| system("codesign", "--verify", f.to_s, out: File::NULL, err: File::NULL) }
    check("every file has a valid signature", signed.empty?, signed.map(&:basename).join(", "))

    puts
    log "#{dylibs.size} dylibs, #{human(dylibs.sum { |f| File.size(f) })} in #{rel(@dest)}"

    puts
    if @failures.zero?
      log "closure is relocatable. Next: the signed hello-world bundle (step 3)."
      0
    else
      log "#{@failures} check(s) failed"
      1
    end
  end

  # An absolute vendored path is taken as-is. An @rpath/ reference has to be
  # resolved through the dependent's own LC_RPATH entries, which is the part the
  # first version of this script missed entirely: Homebrew's OpenEXR refers to
  # libIlmThread as @rpath/libIlmThread-3_4.33.dylib, so a walk that only followed
  # absolute paths silently dropped the whole OpenEXR family. The resulting
  # libvips then failed to dlopen, and FFI fell through to /opt/homebrew/lib
  # without a word - which looks like success on a machine that has Homebrew.
  #
  # Returns nil for anything that is not ours to carry: /usr/lib and /System.
  def resolve_dependency(dep, dependent, rpaths)
    return dep if vendored?(dep)
    return nil unless dep.start_with?("@rpath/")

    name = dep.delete_prefix("@rpath/")
    rpaths.each do |rpath|
      # LC_RPATH entries are themselves often @loader_path-relative, so expand
      # against the dependent's real location before testing.
      base = rpath.gsub("@loader_path", File.dirname(dependent))
                  .gsub("@executable_path", File.dirname(dependent))
      candidate = File.expand_path(File.join(base, name))
      return candidate if File.exist?(candidate) && vendored?(File.realpath(candidate))
    end
    nil
  end

  def resolve(path)
    return nil unless File.exist?(path)

    File.realpath(path)
  rescue SystemCallError
    nil
  end

  def dependencies_of(path)
    out, _err, status = Open3.capture3("otool", "-L", path.to_s)
    return [] unless status.success?

    out.lines.drop(1).filter_map do |line|
      dep = line.strip.split(" (compatibility").first
      dep unless dep.nil? || dep.empty?
    end
  end

  # MH_BUNDLE rather than MH_DYLIB: a dlopen-only plugin, with no install id.
  def bundle?(path)
    out, _err, status = Open3.capture3("otool", "-hv", path.to_s)
    status.success? && out.include?("BUNDLE")
  end

  def install_id_of(path)
    out, _err, status = Open3.capture3("otool", "-D", path.to_s)
    return nil unless status.success?

    out.lines.drop(1).first&.strip
  end

  def rpaths_of(path)
    out, _err, status = Open3.capture3("otool", "-l", path.to_s)
    return [] unless status.success?

    out.scan(/cmd LC_RPATH.*?path ([^\s]+)/m).flatten
  end

  def vendored?(path) = VENDOR_PREFIXES.any? { |prefix| path.start_with?(prefix) }

  # Everything that must be repointed inside the bundle. @rpath belongs here
  # because once the LC_RPATH entries are stripped there is nothing left to
  # resolve it against.
  def rewritable?(dep) = vendored?(dep) || dep.start_with?("@rpath/")

  def check(label, ok, detail = nil)
    @failures += 1 unless ok
    suffix = detail && !detail.empty? && !ok ? "  (#{detail})" : ""
    puts "  #{ok ? "ok  " : "FAIL"} #{label}#{suffix}"
  end

  def run(*cmd)
    _out, err, status = Open3.capture3(*cmd)
    abort "command failed: #{cmd.join(" ")}\n#{err}" unless status.success?
  end

  def human(bytes) = format("%.1f MB", bytes / (1024.0 * 1024))
  def rel(path) = Pathname.new(path).relative_path_from(@root).to_s
  def log(message) = puts("build-vips: #{message}")
end

exit(BuildVips.new(Pathname.new(__dir__).parent.expand_path).call(ARGV) || 0)
